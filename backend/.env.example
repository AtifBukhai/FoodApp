# KhaanaDa Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ============================================================================
# Application
# ============================================================================

NODE_ENV=development
PORT=3000

# ============================================================================
# Database (PostgreSQL / Supabase)
# ============================================================================

# PostgreSQL connection string
# 
# For LOCAL DEVELOPMENT with Supabase:
# 1. Go to your Supabase Dashboard → Settings → Database
# 2. Find "Connection string" → Select "URI" tab
# 3. Use the Session pooler connection (port 5432)
# 4. Format: postgres://[USER].[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
#
# Example (replace with your actual values):
# DATABASE_URL="postgres://postgres.abcdefghijklmnop:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# For local PostgreSQL (if not using Supabase):
# DATABASE_URL=postgresql://khaanada:password@localhost:5432/khaanada?schema=public
#
# IMPORTANT: Never commit your actual DATABASE_URL to Git!
DATABASE_URL=postgresql://khaanada:password@localhost:5432/khaanada?schema=public

# ============================================================================
# Authentication (JWT)
# ============================================================================

# Secret key for JWT signing (generate a strong random string)
# IMPORTANT: Use a different secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT expiration time in seconds (default: 3600 = 1 hour)
JWT_EXPIRATION=3600

# ============================================================================
# CORS
# ============================================================================

# Allowed origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# Rate Limiting
# ============================================================================

# Rate limit time window in seconds
THROTTLE_TTL=60

# Maximum requests per time window
THROTTLE_LIMIT=100

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# Email provider: Resend (https://resend.com)
# Get your API key from: https://resend.com/api-keys
# 
# If not configured, emails will be logged to console (demo mode)
# In production, you MUST configure this for real email delivery
#
# RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be verified in Resend dashboard)
# EMAIL_FROM=noreply@yourdomain.com

# Sender display name
# EMAIL_FROM_NAME=KhaanaDa

# Frontend URL for generating email links (verification, password reset)
# FRONTEND_URL=http://localhost:5173

# Enable email sending (set to 'true' to enable, even without RESEND_API_KEY)
# If false or not set, uses console logging in development
# EMAIL_ENABLED=false

# ============================================================================
# Optional: External Services (For future integrations)
# ============================================================================

# Payment providers (Pakistan-specific)
# JAZZCASH_MERCHANT_ID=
# EASYPAISA_MERCHANT_ID=

# SMS provider
# SMS_PROVIDER=

# Maps API
# MAPS_API_KEY=

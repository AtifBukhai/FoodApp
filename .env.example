# KhaanaDa Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ============================================================================
# API Configuration
# ============================================================================

# Backend API base URL (for Milestone 2+ backend integration)
# Default: http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# ============================================================================
# Maps & Location (Optional - for address validation and delivery zones)
# ============================================================================

# Google Maps API key (or alternative mapping provider)
# Required for: address autocomplete, delivery zone validation, route estimation
# Get one at: https://console.cloud.google.com/google/maps-apis
VITE_MAPS_API_KEY=

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable/disable features during development
# VITE_ENABLE_AI_SUPPORT=false
# VITE_ENABLE_ONLINE_PAYMENTS=false
# VITE_ENABLE_LIVE_TRACKING=false

# ============================================================================
# Third-Party Services (For future integrations)
# ============================================================================

# Payment providers (Pakistan-specific)
# VITE_JAZZCASH_MERCHANT_ID=
# VITE_EASYPAISA_MERCHANT_ID=

# Notification providers
# VITE_EMAIL_PROVIDER=
# VITE_SMS_PROVIDER=

# Analytics (optional)
# VITE_ANALYTICS_ID=

# ============================================================================
# Development Settings
# ============================================================================

# Development server port (optional, default: 5173)
# VITE_PORT=5173

# Enable debug logging (optional)
# VITE_DEBUG=true
